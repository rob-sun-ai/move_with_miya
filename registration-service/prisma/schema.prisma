generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RegistrationStatus {
  Registered
  Waitlisted
  Canceled
}

model Registration {
  id                  Int                  @id @default(autoincrement())
  classId             Int
  userId              String
  status              RegistrationStatus   @default(Registered)
  registeredAt        DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  canceledAt          DateTime?
  waitlistedAt        DateTime?
  promotedAt          DateTime?
  cancellationReason  String?
  source              String               @default("member")

  @@unique([classId, userId])
  @@index([classId, status, registeredAt])
  @@index([classId, status, waitlistedAt])
  @@index([userId, status])
}

enum PaymentStatus {
  Pending
  Paid
  Failed
  Expired
  Refunded
}

enum RefundStatus {
  None
  Pending
  Succeeded
  Failed
  NotEligible
}

model Payment {
  id                       String       @id @default(uuid())
  userId                   String
  classId                  Int
  stripeCheckoutSessionId  String?      @unique
  stripePaymentIntentId    String?      @unique
  stripeRefundId           String?      @unique
  amountCents              Int
  currency                 String
  status                   PaymentStatus @default(Pending)
  refundStatus             RefundStatus  @default(None)
  registrationId           Int?
  refundPercentage         Int?
  refundAmountCents        Int?
  refundRequestedAt        DateTime?
  refundedAt               DateTime?
  refundError              String?
  expiresAt                DateTime
  paidAt                   DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@index([userId, classId, status])
  @@index([classId, status])
  @@index([status, expiresAt])
  @@index([refundStatus, updatedAt])
}

model StripeWebhookEvent {
  id          String    @id @default(uuid())
  stripeEventId String  @unique
  eventType   String
  status      String    @default("Pending")
  error       String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
}

model OutboxEvent {
  id          String    @id @default(uuid())
  eventKey    String    @unique
  eventType   String
  aggregateId String
  payload     Json
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([processedAt, availableAt])
}

model NotificationDelivery {
  id         String    @id @default(uuid())
  eventKey   String    @unique
  status     String    @default("Pending")
  attempts   Int       @default(0)
  lastError  String?
  sentAt     DateTime?
  updatedAt  DateTime  @updatedAt
  createdAt  DateTime  @default(now())
}

model ContactSubmission {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
