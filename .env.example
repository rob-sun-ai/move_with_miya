# ──────────────────────────────────────────
# Move with Miya — Environment Variables
# ──────────────────────────────────────────

# ─── Postgres ─────────────────────────────
POSTGRES_USER=miya
POSTGRES_PASSWORD=miya
POSTGRES_DB=miya
DATABASE_URL=postgresql://miya:miya@localhost:5433/miya
USER_SERVICE_DATABASE_URL=postgresql://miya:miya@localhost:5433/miya_users
CLASSES_SERVICE_DATABASE_URL=postgresql://miya:miya@localhost:5433/miya_classes
REGISTRATION_SERVICE_DATABASE_URL=postgresql://miya:miya@localhost:5433/miya_registrations

# ─── RabbitMQ ─────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ─── Redis (session store) ────────────────
REDIS_URL=redis://localhost:6379

# ─── Session ──────────────────────────────
SESSION_SECRET=change-me-to-a-random-string

# ─── Google OAuth ─────────────────────────
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# ─── CORS ─────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── General ──────────────────────────────
NODE_ENV=development

# ─── Frontend ──────────────────────────────
NEXT_PUBLIC_AUTH_URL=http://localhost:3003/auth/google
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
USER_SERVICE_URL=http://localhost:3003
BACKEND_URL=http://localhost:3002
PUBLIC_APP_URL=http://localhost:5173

# ─── Stripe Checkout ─────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# ─── Contact email (optional in development) ────────────────────────────────
RESEND_API_KEY=
CONTACT_EMAIL_TO=
RESEND_FROM_EMAIL=Move with Miya <onboarding@resend.dev>

# ─── Cloudflare Turnstile ───────────────────────────────────────────────────
CONTACT_CHALLENGE_SECRET=
TURNSTILE_SECRET_KEY=
TURNSTILE_ACTION=contact
TURNSTILE_HOSTNAME=
CONTACT_IP_ATTEMPT_LIMIT=100
CONTACT_IP_ATTEMPT_TTL_MS=600000
CONTACT_COOKIE_SUBMISSION_LIMIT=3
CONTACT_COOKIE_SUBMISSION_TTL_MS=3600000
CHECKOUT_RATE_LIMIT_PREFIX=checkout-rate-limit
CHECKOUT_IP_ATTEMPT_LIMIT=60
CHECKOUT_IP_ATTEMPT_TTL_MS=60000
CHECKOUT_USER_ATTEMPT_LIMIT=5
CHECKOUT_USER_ATTEMPT_TTL_MS=60000
CHECKOUT_REFUND_ATTEMPT_LIMIT=30
CHECKOUT_REFUND_ATTEMPT_TTL_MS=60000
CHECKOUT_REFUND_USER_ATTEMPT_LIMIT=10
CHECKOUT_REFUND_USER_ATTEMPT_TTL_MS=60000
CHECKOUT_STATUS_ATTEMPT_LIMIT=300
CHECKOUT_STATUS_ATTEMPT_TTL_MS=60000
CHECKOUT_STATUS_USER_ATTEMPT_LIMIT=30
CHECKOUT_STATUS_USER_ATTEMPT_TTL_MS=60000

# ─── Production TLS (required by docker-compose.prod.yml) ───────────────────
TLS_CERT_DIR=/etc/letsencrypt
ACME_WEBROOT=/var/www/acme
TLS_CERT_FILE=/etc/letsencrypt/live/example.com/fullchain.pem
TLS_KEY_FILE=/etc/letsencrypt/live/example.com/privkey.pem

# ─── Observability (required by the production stack) ───────────────────────
# Services export traces only when OTEL_EXPORTER_OTLP_ENDPOINT is set in their
# environment; docker-compose.prod.yml points them at the bundled collector.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
GRAFANA_PUBLIC_URL=
PROMETHEUS_RETENTION=14d
PROMETHEUS_RETENTION_SIZE=10GB
ALERT_EMAIL_TO=
ALERT_HEARTBEAT_URL=
ALERTMANAGER_EXTERNAL_URL=http://localhost:9093
RELEASE_VERSION=development
