generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ClassStatus {
  Scheduled
  InProgress
  Completed
  Canceled
}

model Location {
  id        Int         @id @default(autoincrement())
  name      String?
  address   String
  city      String
  state     String
  zipCode   String
  classes   YogaClass[]
}

model YogaClass {
  id          Int         @id @default(autoincrement())
  name        String
  teacherIds  String[]
  capacity    Int
  cost        Decimal     @default(0)
  description String      @default("")
  duration    Int         @default(60)
  imageUrl    String?
  startDate   DateTime
  endDate     DateTime
  status      ClassStatus @default(Scheduled)
  locationId  Int
  location    Location    @relation(fields: [locationId], references: [id])
  isPrivate   Boolean     @default(false) @map("private")
  waitlistEnabled          Boolean     @default(true)
  cancellationCutoffHours  Int         @default(24)
  refundPolicy             Json        @default("[{\"hoursBeforeStart\":24,\"percentage\":100}]")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("yoga_classes")
}
