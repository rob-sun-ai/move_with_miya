# Copy to a deployment-host secret file. Never commit the populated file.
NODE_ENV=production
TZ=UTC
POSTGRES_USER=replace-with-unique-user
POSTGRES_PASSWORD=replace-with-long-random-password
POSTGRES_DB=miya
RABBITMQ_USER=replace-with-unique-user
RABBITMQ_PASS=replace-with-long-random-password
PUBLIC_HOST=your-domain.example
SESSION_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGIN=https://your-domain.example
PUBLIC_APP_URL=https://your-domain.example
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=https://your-domain.example/api/auth/google/callback
NEXT_PUBLIC_AUTH_URL=https://your-domain.example/api/auth/google
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
CONTACT_CHALLENGE_SECRET=replace-with-random-secret
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret
TURNSTILE_HOSTNAME=your-domain.example
RESEND_API_KEY=replace-with-resend-key
CONTACT_EMAIL_TO=studio@your-domain.example
RESEND_FROM_EMAIL=Move with Miya <hello@your-domain.example>
STRIPE_SECRET_KEY=replace-with-stripe-live-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
STRIPE_CURRENCY=usd
TLS_CERT_FILE=/etc/letsencrypt/live/your-domain.example/fullchain.pem
TLS_KEY_FILE=/etc/letsencrypt/live/your-domain.example/privkey.pem
RELEASE_VERSION=replace-with-git-sha
